{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Warsaw",
  "labels": [
    "version-update"
  ],
  "dependencyDashboardTitle": "Version Updates Dashboard",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "commitMessagePrefix": "chore:",
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "automergeSchedule": [
    "* 0-7 * * *"
  ],
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "separateMultipleMinor": true,
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "versioning": "docker"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "CNPG PostgreSQL images",
      "automerge": false,
      "matchDepNames": [
        "/ghcr.io/cloudnative-pg/postgresql/",
        "/ghcr.io/tensorchord/cloudnative-vectorchord/"
      ],
      "additionalBranchPrefix": "{{packageFileDir}}"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+\\.ya?ml$/",
      "/argocd-apps-root-app/.+\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/argocd-apps-root-app/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/apps/.+values\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Upgrade cloudnative-pg PostgreSQL cluster images",
      "customType": "regex",
      "managerFilePatterns": [
        "/apps/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "imageName:\\s*(?<depName>[^\\s:]+):(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
